# Database configuration (PostgreSQL URI or SQLite fallback)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/securesbom
# Default local fallback: sqlite:///./securesbom.db
DATABASE_URL=sqlite:///./securesbom.db

# OSV API Configuration
OSV_API_URL=https://api.osv.dev/v1/query

# NVD API Configuration (Optional API key for higher rate limits)
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# General App Config
ENVIRONMENT=development
DEBUG=True
PORT=8000
OUTPUT_DIR=output
