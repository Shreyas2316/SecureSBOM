# Database configuration (PostgreSQL URI or SQLite fallback)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/securesbom
# Default local fallback resolves relative to project root
DATABASE_URL=sqlite:///./securesbom.db

# External Vulnerability & Threat Intelligence APIs
OSV_API_URL=https://api.osv.dev/v1/query
OSV_BATCH_API_URL=https://api.osv.dev/v1/querybatch
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
GITHUB_TOKEN=

# General App Config
ENVIRONMENT=development
DEBUG=True
PORT=8000
OUTPUT_DIR=output

# Security, Auth & Encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scanner & Resolution Limits
MAX_MANIFEST_BYTES=2097152
TRANSITIVE_MAX_DEPTH=3
TRANSITIVE_MAX_COMPONENTS=500
CACHE_TTL_SECONDS=3600

# AI Provider Settings (server-side only, NEVER share with frontend)
AI_ENABLED=False
# Provider: "mock", "openai", "gemini", "ollama", or "llamacpp"
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_NAME=mock-security-llm
AI_MAX_TOKENS=2048
AI_EXTERNAL_CONSENT_REQUIRED=True

# Continuous Intelligence & Monitoring
INTELLIGENCE_SYNC_INTERVAL_MINUTES=60
RESEARCH_SYNC_INTERVAL_MINUTES=180
REASSESSMENT_INTERVAL_MINUTES=360
CUSTOM_RSS_FEEDS=
