# Database configuration (PostgreSQL URI or SQLite fallback)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/securesbom
# Default local fallback: sqlite:///./securesbom.db
DATABASE_URL=sqlite:///./securesbom.db

# OSV API Configuration
OSV_API_URL=https://api.osv.dev/v1/query

# NVD API Configuration (Optional API key for higher rate limits)
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# General App Config
ENVIRONMENT=development
DEBUG=True
PORT=8000
OUTPUT_DIR=output

# ── AI Provider Settings (server-side only, NEVER share with frontend) ──
# Set AI_ENABLED=True to enable AI-assisted vulnerability analysis
AI_ENABLED=False

# Provider: "openai" (default, also works for Ollama/local) or "gemini"
AI_PROVIDER=openai

# OpenAI-compatible endpoint (set to http://localhost:11434/v1 for Ollama)
AI_BASE_URL=https://api.openai.com/v1

# Your API key (leave blank for local models that don't require one)
AI_API_KEY=

# Model name, e.g.: gpt-4o-mini, gpt-4o, gemini-1.5-flash, llama3.2
AI_MODEL_NAME=

# Max tokens for AI responses
AI_MAX_TOKENS=2048
